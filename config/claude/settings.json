{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "preferredNotifChannel": "notifications_disabled",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --staged)",
      "Bash(git log --oneline)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(docker ps)",
      "Bash(docker compose ps)",
      "Bash(mise current)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/config)",
      "Read(~/.pgpass)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)",
      "Read(//**/.env)",
      "Read(//**/.env.*[^e])",
      "Read(//**/.env.*[^l]e)",
      "Read(//**/.env.*[^p]le)",
      "Read(//**/.env.*[^m]ple)",
      "Read(//**/.env.*[^a]mple)",
      "Read(//**/.env.*[^xs]ample)"
    ]
  }
}
