# tmux for the rice terminal stack: C-Space prefix, truecolor and undercurl inside
# kitty, vi copy mode over OSC 52, and a status line drawn from the palette.
#
# C-h C-j C-k C-l move between panes, except in a pane running Neovim or fzf, which
# gets the key instead: Neovim's own maps move between its splits and call tmux
# select-pane at the edge. The check looks at every process on the pane's tty, not
# just the foreground one, so Neovim started by git commit or kubectl edit counts.
# Any other pane, a shell or Claude Code, loses those keys to navigation, so prefix
# C-h, prefix C-j, prefix C-k and prefix C-l send them through. prefix H J K L
# resize panes, which takes prefix L from last-session; that is prefix BSpace here.
#
# Newlines in Claude Code: Shift+Enter works here only inside kitty. kitty sends a
# bare Shift+Enter as plain Enter and ignores the extended-keys request tmux makes,
# so its kitty.conf maps shift+enter to CSI 13;2u in any window whose title starts
# with "tmux ", which set-titles-string below provides. tmux decodes that as S-Enter
# and, with extended-keys on, forwards it to panes that ask for extended keys, as
# Claude Code does. Anywhere that chain is missing, such as another terminal or a
# tmux reached over ssh, Shift+Enter submits like Enter. Use prefix C-j there, which
# delivers Claude Code's own newline key, or end the line with a backslash and press
# Enter.

set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-kitty:RGB:extkeys:focus:hyperlinks:usstyle:clipboard:strikethrough:sync:title"
set -s extended-keys on
set -s extended-keys-format csi-u
set -s escape-time 10
set -s focus-events on
set -s set-clipboard on
set -g allow-passthrough on
set -ga update-environment WAYLAND_DISPLAY
set -ga update-environment KITTY_LISTEN_ON
set -ga update-environment KITTY_WINDOW_ID

set -g history-limit 20000
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
setw -g mode-keys vi
set -g status-keys emacs
set -g detach-on-destroy off
set -g display-time 2000
set -g set-titles on
set -g set-titles-string "tmux #S: #W"
setw -g aggressive-resize on

set -g prefix C-Space
unbind C-b
bind C-Space send-prefix

bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"
bind -r H resize-pane -L 5
bind -r J resize-pane -D 3
bind -r K resize-pane -U 3
bind -r L resize-pane -R 5
bind BSpace switch-client -l
bind r source-file ~/.config/tmux/tmux.conf \; display-message "tmux.conf reloaded"

# With set-clipboard on, every copy also reaches the system clipboard over OSC 52.
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi C-v send -X rectangle-toggle
bind -T copy-mode-vi y send -X copy-selection-and-cancel

%hidden is_vim="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?\\.?(view|l?n?vim?x?|fzf)(diff)?(-wrapped)?$'"
bind -n C-h if-shell "$is_vim" "send-keys C-h" "select-pane -L"
bind -n C-j if-shell "$is_vim" "send-keys C-j" "select-pane -D"
bind -n C-k if-shell "$is_vim" "send-keys C-k" "select-pane -U"
bind -n C-l if-shell "$is_vim" "send-keys C-l" "select-pane -R"
bind -T copy-mode-vi C-h select-pane -L
bind -T copy-mode-vi C-j select-pane -D
bind -T copy-mode-vi C-k select-pane -U
bind -T copy-mode-vi C-l select-pane -R
bind C-h send-keys C-h
bind C-j send-keys C-j
bind C-k send-keys C-k
bind C-l send-keys C-l

# Claude Code in a side split, rooted at the pane's git repository or, outside one,
# at the pane's directory.
bind a run-shell 'command -v claude >/dev/null 2>&1 || { tmux display-message "claude is not on PATH"; exit 0; }; cd #{q:pane_current_path} && exec tmux split-window -h -t "#{pane_id}" -c "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" claude'

set -g status-position bottom
set -g status-justify left
set -g status-style "bg=default,fg=@@FG1@@"
set -g status-left-length 40
set -g status-left "#[fg=@@BG0@@,bg=@@ACCENT@@,bold] #S #[default] "
set -g status-right-length 80
set -g status-right "#{?client_prefix,#[fg=@@YELLOW@@#,bold]PREFIX ,}#{?pane_in_mode,#[fg=@@MAGENTA@@#,bold]COPY ,}#[fg=@@FG2@@#,nobold]#{=/-48/...;s|^$HOME|~|:pane_current_path} "
set -g window-status-separator ""
setw -g window-status-format "#[fg=@@FG2@@] #I #W "
setw -g window-status-current-format "#[fg=@@ACCENT@@,bold] #I #W#{?window_zoomed_flag, [z],} "
setw -g window-status-activity-style "fg=@@YELLOW@@"
setw -g window-status-bell-style "fg=@@RED@@,bold"

setw -g pane-border-style "fg=@@BG3@@"
setw -g pane-active-border-style "fg=@@ACCENT@@"
set -g message-style "bg=@@BG2@@,fg=@@FG0@@"
set -g message-command-style "bg=@@BG2@@,fg=@@ACCENT@@"
setw -g mode-style "bg=@@SEL@@,fg=@@FG0@@"
setw -g copy-mode-match-style "bg=@@BG3@@,fg=@@FG0@@"
setw -g copy-mode-current-match-style "bg=@@YELLOW@@,fg=@@BG0@@"
setw -g popup-border-style "fg=@@ACCENT@@"
setw -g popup-border-lines rounded
set -g menu-style "bg=@@BG1@@,fg=@@FG0@@"
set -g menu-selected-style "bg=@@SEL@@,fg=@@FG0@@"
set -g menu-border-style "fg=@@BG3@@"
setw -g clock-mode-colour "@@ACCENT@@"
set -g display-panes-active-colour "@@ACCENT@@"
set -g display-panes-colour "@@FG2@@"
