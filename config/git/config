# Global git defaults from the rice bootstrap: delta as the pager, a global ignore
# file and a set of aliases.
#
# This is git's XDG config. Git reads it before ~/.gitconfig, so any key set there,
# by hand or by phase 40, wins over the same key here. The rice phase keeps a
# ~/.gitconfig in place, because without one git config --global writes here.

[include]
	path = delta.gitconfig

[alias]
	st = status --short --branch
	lg = log --graph --date=short --pretty=format:'%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %s%C(auto)%d%C(reset) %C(dim)%an%C(reset)'
	last = log -1 HEAD --stat
	ds = diff --staged
	sbs = -c delta.side-by-side=true diff
	unstage = restore --staged --
	amend = commit --amend --no-edit
	fixup = commit --fixup
	undo = reset --soft HEAD~1
	pushf = push --force-with-lease
	recent = for-each-ref --sort=-committerdate --count=20 --format='%(committerdate:relative)%09%(refname:short)' refs/heads/
	root = rev-parse --show-toplevel
