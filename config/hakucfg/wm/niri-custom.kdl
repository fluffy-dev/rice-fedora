// Personal niri overrides, deployed to ~/hakucfg/wm/niri-custom.kdl.
//
// ~/.config/niri/config.kdl includes this file last, and hakuspace rewrites
// every other ~/.config/niri/*.kdl on update, so this is the only niri file
// that may hold anything personal.
//
// Merge rules, which decide where each block below can live:
//   - environment, input, layout and binds merge key by key, last one wins.
//   - window-rule, layer-rule, output and workspace append. A later rule wins
//     only for the properties it names, and only for windows it matches.
//
// It replaces the stub hakuspace ships, whose focus-ring block is `off`.
//
// phases/30-theme.sh fills in every name written between double at-signs: the
// panel's output name and scale, the xkb layouts and options, and the path of
// the layout watcher. Until then this file is a template, not valid KDL.
//
// Keyboard layout switching follows LAYOUT_SWITCH in config.env:
//   alt_shift        options "rice:alt_shift_release,compose:ralt"
//   alt_shift_press  options "grp:lalt_lshift_toggle,compose:ralt"
//   caps             options "grp:caps_toggle,compose:ralt"
//   none             options "compose:ralt", leaving only Mod+Shift+Space
//
// rice:alt_shift_release is not part of xkeyboard-config. The phase seeds it
// into ~/.config/xkb/rules/evdev and ~/.config/xkb/symbols/rice before this
// file is installed. It switches on a lone Alt+Shift press and release, so a
// chord such as Mod+Shift+Alt+Left keeps every modifier and never flips the
// layout. It relies on lockOnRelease, which exists only in the v2 keymap format.
// libxkbcommon 1.13 compiles named keymaps as v2, but only a live session
// proves that niri's keymap gets it. If
//   journalctl --user -b | grep 'error loading the configured xkb keymap'
// finds anything, niri has fallen back to its default US-only keymap. The
// fallback is alt_shift_press, the stock grp:lalt_lshift_toggle. It switches
// on press, so an Alt+Shift chord also flips the layout and loses one of its
// modifiers. grp:alt_shift_toggle is no substitute: it also claims Right
// Alt+Right Shift, which breaks the compose key.

environment {
    // The shipped environment.kdl asks for iHD, the Intel media driver. This
    // machine is a Radeon 680M, where iHD initialises nothing and every VA-API
    // consumer falls back to software decode.
    LIBVA_DRIVER_NAME "radeonsi"

    // Same reason: va_gl is the VDPAU-on-top-of-VA-API shim for GPUs with no
    // native VDPAU driver. Mesa ships a real radeonsi one.
    VDPAU_DRIVER "radeonsi"

    // The shipped config points all four input-method variables at fcitx5 and
    // autostarts it, but fcitx5 is in no package list. English and Russian are
    // both plain xkb layouts (see input.keyboard below), so the input method is
    // dead weight; left pointing at fcitx, GTK and Qt apps stall on a bus name
    // that never appears and some drop key events entirely. Empty means "use
    // the toolkit default", which on Wayland is text-input-v3.
    GTK_IM_MODULE ""
    QT_IM_MODULE ""
    XMODIFIERS ""
    SDL_IM_MODULE ""

    // Unset, not set. niri has created the X11 sockets, exported DISPLAY and
    // spawned xwayland-satellite itself since v25.08, and it picks whichever
    // display number is free. environment.kdl pins DISPLAY to ":0" regardless,
    // so if niri lands on :1 every X11 client dials a socket that is not there.
    // null removes the pin and lets niri's own value through.
    DISPLAY null
}

// No xwayland-satellite spawn here on purpose. niri integrates it natively from
// v25.08 onward and Fedora 44 ships 0.8.2, comfortably past the 0.7 that needs.
// niri creates the sockets, exports DISPLAY and manages the process lifecycle, so
// a manual spawn would fight it for the socket rather than help.

// Announces every keyboard layout switch, whether it came from xkb, from the
// Mod+Shift+Space bind or from `niri msg action switch-layout`. niri runs
// startup spawns once rather than on every config reload, and the watcher exits
// when niri closes its IPC socket, so each session has exactly one.
spawn-sh-at-startup "exec \"@@LAYOUT_NOTIFY@@\" @@XKB_LAYOUT@@"

output "@@OUTPUT_NAME@@" {
    scale @@DISPLAY_SCALE@@
}

input {
    // Focus only windows the pointer is already fully over. Without the 0%
    // cap, brushing the edge of a partly visible column scrolls the view out
    // from under the cursor, which is unusable on a single narrow screen.
    focus-follows-mouse max-scroll-amount="0%"

    keyboard {
        // Filled in from KEYBOARD_LAYOUTS and LAYOUT_SWITCH, as the header
        // describes. Neither line may go: an empty xkb section makes niri read
        // the layouts and options from org.freedesktop.locale1 instead. Right
        // Alt composes in every mode, which is how to reach the accented and
        // typographic characters a us layout has no key for.
        xkb {
            layout "@@XKB_LAYOUT@@"
            options "@@XKB_OPTIONS@@"
        }

        // track-layout stays at its default, global. Set to "window", niri
        // restores each window's own layout on every focus change, and each of
        // those restores would raise the layout notification with no key pressed.

        // Repeat fast enough that holding a key to move a cursor across a line
        // of code is quicker than reaching for the arrow cluster.
        repeat-delay 250
        repeat-rate 40

        numlock
    }

    // Pointing device sections replace rather than merge, so every option that
    // should survive has to be repeated here, including the shipped ones.
    touchpad {
        tap
        natural-scroll
        click-method "clickfinger"
        // The palm rests on the pad while typing, and the thumb brushes it
        // while using the trackpoint.
        dwt
        dwtp
    }
}

layout {
    // 16px of gap around every window costs about 5% of the usable width of a
    // 14 inch panel, which is most of a terminal column.
    gaps 10

    // The stub this file replaces switched the ring off. With border off
    // upstream, the ring is the only thing that says which column has focus.
    //
    // active-color is deliberately absent. ~/.local/state/hakuspace/theme/
    // niri-style.kdl is included immediately before this file and sets it to
    // the generated accent, so the ring stays teal and keeps following the
    // `accent` helper instead of being pinned to one colour here.
    focus-ring {
        on
        width 3
        inactive-color "#2A3A38"
        urgent-color "#C05050"
    }

    // Replaces the shipped list rather than extending it. Thirds and halves are
    // what actually fit an editor beside a terminal on a 14 inch panel.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
}

// The shipped keybinds.kdl already binds column focus and movement (Mod+A/S and
// the arrows), consume and expel (Mod+Ctrl+A/S, Mod+BracketLeft/BracketRight,
// Mod+comma and Mod+period), width cycling (Mod+D, Mod+Shift+R), centring
// (Mod+G, Mod+H), workspaces (Mod+1-9), screenshots (Print, Mod+P) and the
// media keys. Everything here either adds a bind or deliberately takes one
// over; the five it takes over are called out where they happen.
//
// The keys a macOS switcher reaches for without thinking are Cmd+C, V, S, A, Z,
// F, T, W and Q, and Cmd here is Mod. Upstream points two of those at something
// that destroys work: Mod+C closes the focused window, and Mod+Shift+V wipes the
// clipboard history. Both are taken over below. The rest are left alone: Mod+A
// and Mod+S move column focus, Mod+F maximises a column, Mod+Z toggles floating
// and Mod+T raises the cava bar. Those are surprising the first time and undone
// by pressing the same key again, which is a different class of problem from
// losing an unsaved buffer, and moving them would cost upstream's own muscle
// memory for no safety gained.
binds {
    // --- launch -------------------------------------------------------------
    Mod+Return       hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Shift+Return hotkey-overlay-title="Floating Scratch Terminal" { spawn "kitty" "--class" "haku-scratch"; }
    Mod+Space        hotkey-overlay-title="Application Launcher" { spawn "rofi" "-show" "drun"; }
    Mod+Escape       hotkey-overlay-title="Lock Session" { spawn-sh "$HOME/.local/bin/lock.sh"; }

    // --- close --------------------------------------------------------------
    // Cmd+W and Cmd+Q both end a window on macOS, and neither of them opens a
    // terminal. Takes over Mod+W (dockbar toggle, rebound below) and Mod+Q
    // (a second terminal bind, which Mod+Return already covers).
    Mod+W repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }

    Mod+Shift+D hotkey-overlay-title="Toggle Dockbar" { spawn-sh "$HOME/.local/bin/dockbar_manager.sh --toggle"; }

    // --- clipboard ----------------------------------------------------------
    // Cmd+C is the single most reflexive key on the keyboard and upstream binds
    // it to close-window, so a copy aimed at a window that turns out not to own
    // a text selection throws the window away instead. Takes over Mod+C and
    // points it at the clipboard menu, which is the nearest thing the desktop
    // has to a copy and cannot lose anything.
    Mod+C hotkey-overlay-title="Clipboard Menu" { spawn-sh "$HOME/.local/bin/clipboard_menu.sh"; }

    // Cmd+Shift+V is paste-without-formatting on macOS and reached for almost
    // as often as plain paste; upstream wipes the clipboard history with it.
    // Takes over Mod+Shift+V, and the wipe moves to a chord nobody types by
    // reflex.
    Mod+Shift+V      hotkey-overlay-title="Clipboard Menu" { spawn-sh "$HOME/.local/bin/clipboard_menu.sh"; }
    Mod+Ctrl+Shift+V hotkey-overlay-title="Wipe Clipboard" { spawn-sh "$HOME/.local/bin/clipboard_menu.sh --wipe"; }

    // --- switching ----------------------------------------------------------
    // Cmd+Tab is a keyboard-only jump back to the window used before this one,
    // not Mission Control: the two are different gestures and only one of them
    // is what the hand expects from Tab. focus-window-previous is that jump.
    // The overview, which is the Mission Control half, moves one Shift away and
    // is still on Mod+Grave upstream. Takes over Mod+Tab; the Haku menu those
    // two displace lands on Mod+Ctrl+Tab.
    Mod+Tab       repeat=false hotkey-overlay-title="Previous Window" { focus-window-previous; }
    Mod+Shift+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+Ctrl+Tab  hotkey-overlay-title="Haku Menu" { spawn-sh "$HOME/.local/bin/hakumenu.sh"; }

    // --- keyboard layout ----------------------------------------------------
    // A switch that works in every LAYOUT_SWITCH mode, none included. niri's
    // own default config offers this pair on Mod+Space and Mod+Shift+Space;
    // Mod+Space is the launcher here, and with two layouts next and prev are
    // the same move, so one bind covers it. It announces nothing itself:
    // layout-notify, started near the top of this file, raises the notification
    // for every switch however it happened, so a notify-send here would show two.
    Mod+Shift+Space hotkey-overlay-title="Switch Keyboard Layout" { switch-layout "next"; }

    // Mod+H and Mod+L are taken upstream, so only the vertical half of hjkl is
    // available for moving around inside a column.
    Mod+J       { focus-window-down; }
    Mod+K       { focus-window-up; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Workspaces stack vertically, and Mod+1-9 only reaches them by index.
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    // Docked to an external monitor.
    Mod+Alt+Left        { focus-monitor-left; }
    Mod+Alt+Right       { focus-monitor-right; }
    Mod+Shift+Alt+Left  { move-column-to-monitor-left; }
    Mod+Shift+Alt+Right { move-column-to-monitor-right; }

    // --- sizing -------------------------------------------------------------
    // Jump straight to a width instead of cycling Mod+D round to it. Left to
    // right across the row is narrow to wide: logs, half, editor.
    Mod+U { set-column-width "33.333%"; }
    Mod+I { set-column-width "50%"; }
    Mod+O { set-column-width "66.667%"; }

    // --- capture ------------------------------------------------------------
    // Cmd+Shift+3/4 muscle memory. There is deliberately no Mod+Shift+5: it
    // would run record.sh, which hard-requires wl-screenrec, and Fedora ships
    // no such package in any release or in a working copr. Upstream's own
    // Mod+F11 already reaches record.sh for anyone who builds the recorder by
    // hand, so a second bind would only add another key that answers with a
    // "Missing dependencies" toast while claiming "Record Screen" in the
    // hotkey overlay.
    Mod+Shift+3 { screenshot-screen; }
    Mod+Shift+4 { screenshot; }
}

// The shipped rules.kdl blurs, adds noise to and doubles the saturation behind
// every window, and dims inactive ones to 0.9. That is a full-screen shader
// pass per frame plus a blend on an iGPU that shares its power budget with the
// CPU. Re-declaring the same matches here switches both off: rules append, and
// the last rule naming a property wins.
window-rule {
    match app-id=r#".*"#

    background-effect {
        blur false
        xray false
        noise 0.0
        saturation 1.0
    }
}

window-rule {
    match is-active=false
    opacity 1.0
}

window-rule {
    match app-id="^haku-scratch$"

    open-floating true
    default-column-width { proportion 0.45; }
}

window-rule {
    match app-id=r#"^jetbrains-"#
    open-maximized true
}

// JetBrains draws completion popups, tooltips and the splash screen as separate
// X11 toplevels named win0, win1 and so on. Tiled, each one takes focus and
// pushes the editor off screen.
window-rule {
    match app-id=r#"^jetbrains-"# title=r#"^win\d+$"#
    open-floating true
}
