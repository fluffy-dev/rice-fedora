" Blends TINT into BASE by AMOUNT, for tinted backgrounds the palette has no slot for.
function! s:mix(base, tint, amount) abort
  let l:base = map([1, 3, 5], {_, i -> str2nr(a:base[i : i + 1], 16)})
  let l:tint = map([1, 3, 5], {_, i -> str2nr(a:tint[i : i + 1], 16)})
  let l:rgb = map(l:base, {i, c -> float2nr(round(c + (l:tint[i] - c) * a:amount))})
  return printf('#%02x%02x%02x', l:rgb[0], l:rgb[1], l:rgb[2])
endfunction

