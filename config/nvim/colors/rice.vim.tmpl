" -------------------------------------------------------------- diagnostics --
for [s:severity, s:color, s:line] in [
      \ ['Error', s:red, 'undercurl'],
      \ ['Warn', s:yellow, 'undercurl'],
      \ ['Info', s:blue, 'underdotted'],
      \ ['Hint', s:fg2, 'underdotted'],
      \ ['Ok', s:green, 'underline'],
      \ ]
  call s:hl('Diagnostic' . s:severity, #{fg: s:color})
  call s:hl('DiagnosticSign' . s:severity, #{fg: s:color, bold: v:true})
  call s:hl('DiagnosticVirtualText' . s:severity, #{fg: s:color, bg: s:mix(s:bg0, s:color, 0.1)})
  call s:hl('DiagnosticUnderline' . s:severity, {s:line: v:true, 'sp': s:color})
  call s:hl('RiceStl' . s:severity, #{fg: s:color, bg: s:bg1})
endfor
unlet s:severity s:color s:line
call s:hl('DiagnosticUnnecessary', #{fg: s:fg2})
call s:hl('DiagnosticDeprecated', #{strikethrough: v:true, sp: s:fg2})

