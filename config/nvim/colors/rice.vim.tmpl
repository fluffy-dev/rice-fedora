" rice: a calm dark colorscheme drawn from the rice terminal palette.
"
" Rendered from config/palette.env at deploy time, so the accent follows ACCENT in
" config.env. The accent marks focus and nothing else: the cursor line number,
" the current search match, completion matches, float titles and the mode label.
" Syntax keeps to muted blues, greens, yellows and neutrals.
"
" Normal has no background of its own. The terminal paints the same palette, and
" leaving it unset lets kitty's background opacity show through.

set background=dark
highlight clear
if exists('syntax_on')
  syntax reset
endif
let g:colors_name = 'rice'

