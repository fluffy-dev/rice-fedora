#!/usr/bin/env bash
# The terminal-side colour palette, shared by kitty, Neovim, tmux, fzf, delta and
# lazygit so every tool reads as one system.
#
# Templates reference these as @@NAME@@ tokens (PALETTE_BG0 becomes @@BG0@@) and
# are rendered by lib/deploy.sh at deploy time. The accent follows ACCENT in
# config.env, so changing it there and re-running phases 60-62 recolours the whole
# terminal stack. ANSI 6, the slot most CLI tools use for highlights, is tied to the
# accent on purpose.
#
# shellcheck disable=SC2034  # every value here is consumed through render_template

PALETTE_ACCENT="${ACCENT,,}"

PALETTE_BG0="#0e1417"
PALETTE_BG1="#141c20"
PALETTE_BG2="#1b262b"
PALETTE_BG3="#26343a"
PALETTE_SEL="#1f3d39"

PALETTE_FG0="#d3dde0"
PALETTE_FG1="#a3b1b6"
PALETTE_FG2="#7a8b92"

PALETTE_AQUA="#6bc6e8"
PALETTE_EMERALD="#4fd18b"
PALETTE_BLUE="#6fa3dc"
PALETTE_GREEN="#97cf87"
PALETTE_YELLOW="#e2c47e"
PALETTE_ORANGE="#e59a6e"
PALETTE_RED="#e5737a"
PALETTE_MAGENTA="#b995c4"

PALETTE_ANSI0="#1b262b"
PALETTE_ANSI1="#e5737a"
PALETTE_ANSI2="#97cf87"
PALETTE_ANSI3="#e2c47e"
PALETTE_ANSI4="#6fa3dc"
PALETTE_ANSI5="#b995c4"
PALETTE_ANSI6="${ACCENT,,}"
PALETTE_ANSI7="#c3cdd1"
PALETTE_ANSI8="#5f7078"
PALETTE_ANSI9="#f08d93"
PALETTE_ANSI10="#b0dea2"
PALETTE_ANSI11="#ecd49f"
PALETTE_ANSI12="#8fbbe9"
PALETTE_ANSI13="#ccafd5"
PALETTE_ANSI14="#84dbc0"
PALETTE_ANSI15="#eef3f5"
