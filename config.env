#!/usr/bin/env bash
# User-tunable settings for the rice bootstrap.
#
# Every knob lives here so the whole setup can be re-targeted without reading a
# phase script. To keep machine-specific values out of git, copy this file to
# config.local.env and edit that instead; it is sourced afterwards and wins.
#
# shellcheck disable=SC2034  # every value here is consumed by a phase script

# ---------------------------------------------------------------- appearance --
# Accent colour propagated to Waybar, Rofi, Kitty, SwayNC and the lock screen.
# Must stay reasonably bright: gen_style.sh rejects colours it judges too dark
# and silently falls back to white.
ACCENT="#5EC8A8"          # teal, the midpoint of blue and green
ACCENT_ALT_AQUA="#6BC6E8" # selectable later with: accent aqua
ACCENT_ALT_EMERALD="#4FD18B"

FONT_FAMILY="JetBrainsMono Nerd Font"

# Drives waybar, kitty, rofi, swaync and the lock screen through gen_style.sh.
# 13 rather than upstream's 11 because this panel is dense: 1920x1200 on a 14 inch
# 16:10 screen is about 162 ppi, where 11 px of bar text stands 1.7 mm tall. Raising
# the font is preferable to raising DISPLAY_SCALE, which would blur XWayland apps.
FONT_SIZE=13

# Pinned rather than auto-detected: this machine is the 14 inch WUXGA panel,
# 1920x1200, where 1.0 is correct. Fractional scaling would only blur XWayland
# clients for no gain. Set to empty to go back to detecting it at runtime.
DISPLAY_SCALE="1.0"

# Seconds between automatic wallpaper changes.
WALLPAPER_INTERVAL=300

# Generate a set of teal/blue/green gradient wallpapers matched to the accent.
# Requires ImageMagick, which phase 20 installs.
GENERATE_WALLPAPERS=true

# ------------------------------------------------------------------ upstream --
# Pinned deliberately. The non-interactive answer sequence in phase 20 encodes
# this tag's prompt order; an unpinned clone could answer the wrong questions
# silently. Bump only after re-reading upstream's install.sh.
HAKUSPACE_TAG="v2.3.1"
HAKUSPACE_DIR="$HOME/hakuspace"

# -------------------------------------------------------------------- laptop --
# Memory headroom. This machine has 16 GB of soldered LPDDR5 and no upgrade path,
# and a JetBrains IDE plus containers plus a browser will exhaust it. Fedora ships
# zram but no disk swap, so a hard squeeze ends in the OOM killer taking whichever
# process it likes rather than in a slow patch. A swap file on the 1 TB NVMe costs
# disk nobody is using and converts those kills into survivable slowness.
# Not for hibernation, which stays out of scope while Windows shares the disk.
ENABLE_SWAPFILE=true
SWAPFILE_SIZE_GB=16

# ThinkPad battery charge ceiling. 80 roughly doubles cell lifespan on a machine
# that mostly lives plugged in. Set to 100 to disable the limit.
BATTERY_CHARGE_LIMIT=80

# --------------------------------------------------------------------- ident --
# Leave empty to skip git configuration and SSH key generation.
GIT_NAME=""
GIT_EMAIL=""

# ------------------------------------------------------------------- toggles --
ENABLE_DOCKER=true
ENABLE_K8S=true
ENABLE_JETBRAINS=true
ENABLE_VSCODE=true
ENABLE_ZEN=true
ENABLE_MISE=true

# Flatpak plus the complete, unfiltered Flathub remote. Fedora's own repositories
# carry no Slack, Zoom or Teams, and Workstation only adds Flathub when someone
# accepts the third-party repository prompt at first boot - which a scripted
# install never sees. The copy that prompt adds is filtered to a short list that
# excludes all three, so video calls with screen sharing need this.
ENABLE_FLATPAK=true

# Terminal-centred development, phases 60 to 62: Neovim with vim-plug and a
# VimScript config, kitty/fish/tmux/git polish, and Claude Code wiring across the
# shell, the terminal and the editor.
ENABLE_NEOVIM=true
ENABLE_TMUX=true
ENABLE_CLAUDE_CODE=true

# psql plus the Neovim database UI. Postgres itself is expected to run in Docker.
ENABLE_DB_TOOLS=true

# Default language runtimes installed globally via mise.
MISE_RUNTIMES=("go@latest" "node@lts" "python@3.12" "java@temurin-21")
